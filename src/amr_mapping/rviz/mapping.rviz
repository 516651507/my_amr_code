Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
    - Class: rviz/TF
      Name: TF
      Enabled: true
    - Class: rviz/LaserScan
      Name: Lidar
      Enabled: true
      Topic: /lidar1/scan_filtered
      Color: 255; 64; 64
    - Class: rviz/Map
      Name: Map
      Enabled: true
      Topic: /map
    - Class: rviz/Odometry
      Name: WheelOdom
      Enabled: true
      Topic: /wheel_odom
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz/MoveCamera
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Target Frame: base_link
Window Geometry:
  Height: 800
  Width: 1200
