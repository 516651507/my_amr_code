<?xml version="1.0"?>
<!--
  占位模型，不是实测 URDF。
  车体约 800 x 490 mm，base_link 取几何中心。
  激光：蓝海 LDS-50C-E，frame 常用 laser_link；与 mars_tf_bridge 一致时为 base_link 单位变换。
  相机：奥比中光大白 DW2 ×2，link 为占位；点云 header.frame_id 必须能 TF 到 base_link。
  若 mars_tf_bridge 或 ~/camera_ws 驱动已在发同名 TF，勿再启动本 description。
-->
<robot name="amr" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="laser_xyz" default="0 0 0"/>
  <xacro:arg name="laser_rpy" default="0 0 0"/>
  <xacro:arg name="camera_xyz" default="0.35 0.12 0.25"/>
  <xacro:arg name="camera_rpy" default="0 0 0"/>
  <xacro:arg name="camera2_xyz" default="0.35 -0.12 0.25"/>
  <xacro:arg name="camera2_rpy" default="0 0 0"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry>
        <box size="0.80 0.49 0.30"/>
      </geometry>
      <material name="amr_gray">
        <color rgba="0.2 0.45 0.75 0.8"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry>
        <box size="0.80 0.49 0.30"/>
      </geometry>
    </collision>
  </link>

  <link name="laser_link"/>
  <joint name="base_to_laser" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="$(arg laser_xyz)" rpy="$(arg laser_rpy)"/>
  </joint>

  <!-- 相机 1：话题 /camera/depth/points_cam 的坐标系占位 -->
  <link name="camera_link"/>
  <joint name="base_to_camera" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="$(arg camera_xyz)" rpy="$(arg camera_rpy)"/>
  </joint>
  <link name="camera_depth_frame"/>
  <joint name="camera_depth_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_depth_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="camera_depth_optical_frame"/>
  <joint name="camera_depth_optical_joint" type="fixed">
    <parent link="camera_depth_frame"/>
    <child link="camera_depth_optical_frame"/>
    <!-- ROS 光学坐标系：Z 前、X 右、Y 下 -->
    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
  </joint>

  <!-- 相机 2：话题 /camera2/depth/points_cam -->
  <link name="camera2_link"/>
  <joint name="base_to_camera2" type="fixed">
    <parent link="base_link"/>
    <child link="camera2_link"/>
    <origin xyz="$(arg camera2_xyz)" rpy="$(arg camera2_rpy)"/>
  </joint>
  <link name="camera2_depth_frame"/>
  <joint name="camera2_depth_joint" type="fixed">
    <parent link="camera2_link"/>
    <child link="camera2_depth_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="camera2_depth_optical_frame"/>
  <joint name="camera2_depth_optical_joint" type="fixed">
    <parent link="camera2_depth_frame"/>
    <child link="camera2_depth_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
  </joint>
</robot>
