<launch>
  <!--
    定位用已保存的地图 + amcl。
    局部避障用融合扫描（标准 ObstacleLayer，负责打点和清障）
    加上自研 FusionObstacleLayer（融合点云，负责相机看到的高度障碍）。
    自动速度只发 /autoVel_cmd，不占用手动 /cmd_vel。
  -->
  <arg name="map_file" default="$(find amr_mapping)/maps/placeholder.yaml"/>
  <arg name="publish_description_tf" default="true"/>
  <arg name="publish_wheel_odom_tf" default="true"/>
  <arg name="scan_topic" default="/lidar1/scan_filtered"/>
  <arg name="odom_topic" default="/wheel_odom"/>
  <arg name="cmd_topic" default="/autoVel_cmd"/>
  <arg name="with_watchdog" default="true"/>
  <arg name="rviz" default="false"/>

  <include file="$(find amr_description)/launch/description.launch" if="$(arg publish_description_tf)"/>
  <include file="$(find amr_bringup)/launch/odom_tf.launch" if="$(arg publish_wheel_odom_tf)">
    <arg name="odom_topic" value="$(arg odom_topic)"/>
  </include>
  <include file="$(find amr_bringup)/launch/watchdog.launch" if="$(arg with_watchdog)"/>
  <include file="$(find amr_mapping)/launch/load_map.launch">
    <arg name="map_file" value="$(arg map_file)"/>
  </include>

  <node pkg="amcl" type="amcl" name="amcl" output="screen">
    <remap from="scan" to="$(arg scan_topic)"/>
    <rosparam command="load" file="$(find amr_navigation)/config/amcl.yaml"/>
  </node>

  <include file="$(find amr_obstacle_fusion)/launch/fusion.launch"/>

  <include file="$(find amr_navigation)/launch/move_base.launch">
    <arg name="cmd_topic" value="/amr/cmd_vel_raw"/>
  </include>

  <node pkg="amr_navigation" type="cmd_smoother.py" name="cmd_smoother" output="screen">
    <rosparam command="load" file="$(find amr_navigation)/config/cmd_smoother.yaml"/>
    <param name="cmd_out_topic" value="$(arg cmd_topic)"/>
  </node>

  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz_navigation"
        args="-d $(find amr_navigation)/rviz/navigation.rviz"/>
</launch>
