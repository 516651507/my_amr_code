<launch>
  <!-- 自研全栈：底盘 + 描述 + 雷达滤波 +（可选）相机 + 看门狗 -->
  <arg name="port" default="/dev/ttyS4"/>
  <arg name="publish_description_tf" default="true"/>
  <arg name="start_lidar" default="true"/>
  <arg name="start_bluesea" default="false"/>
  <arg name="start_cameras" default="false"/>
  <arg name="with_watchdog" default="true"/>

  <include file="$(find amr_chassis)/launch/chassis.launch">
    <arg name="port" value="$(arg port)"/>
  </include>

  <include file="$(find amr_description)/launch/description.launch" if="$(arg publish_description_tf)"/>

  <include file="$(find amr_lidar)/launch/lidar.launch" if="$(arg start_lidar)">
    <arg name="start_bluesea" value="$(arg start_bluesea)"/>
  </include>

  <include file="$(find amr_camera)/launch/dw2_dual.launch">
    <arg name="start_cameras" value="$(arg start_cameras)"/>
  </include>

  <include file="$(find amr_bringup)/launch/stack_contract.launch" if="$(arg with_watchdog)"/>
</launch>
