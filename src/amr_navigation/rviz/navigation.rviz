Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
  - Class: rviz/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
    - Class: rviz/TF
      Name: TF
      Enabled: true
    - Class: rviz/Map
      Name: Map
      Enabled: true
      Topic: /map
    - Class: rviz/LaserScan
      Name: FusedScan
      Enabled: true
      Topic: /amr/fusion/scan
      Color: 255; 80; 80
    - Class: rviz/PointCloud2
      Name: FusedCloud
      Enabled: true
      Topic: /amr/fusion/cloud
      Color Transformer: FlatColor
      Color: 80; 180; 255
    - Class: rviz/Map
      Name: GlobalCostmap
      Enabled: false
      Topic: /move_base/global_costmap/costmap
    - Class: rviz/Map
      Name: LocalCostmap
      Enabled: true
      Topic: /move_base/local_costmap/costmap
    - Class: rviz/Path
      Name: GlobalPlan
      Enabled: true
      Topic: /move_base/GlobalPlanner/plan
    - Class: rviz/Path
      Name: LocalPlan
      Enabled: true
      Topic: /move_base/TebLocalPlannerROS/local_plan
    - Class: rviz/Polygon
      Name: Footprint
      Enabled: true
      Topic: /move_base/local_costmap/footprint
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz/MoveCamera
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Target Frame: base_link
Window Geometry:
  Height: 800
  Width: 1400
