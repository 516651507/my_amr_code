<launch>
  <!--
    安装 bluesea2 后复制为 lidar_bluesea_lds50ce.driver.launch
    cp lidar_bluesea_lds50ce.driver.launch.example lidar_bluesea_lds50ce.driver.launch

    LDS-50C-E UDP：eth1=192.168.158.15，雷达 192.168.158.98:6668
    驱动默认发布 /scan → relay 到项目约定 /lidar1/laser_fan
  -->
  <arg name="frame_id" default="laser_link"/>

  <include file="$(find bluesea2)/launch/udp_lidar.launch"/>
  <!-- /scan → /lidar1/laser_fan 由 amr_lidar/lidar.launch 的 relay 完成 -->
</launch>
